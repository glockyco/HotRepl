<Project>
  <!--
    Solution-wide MSBuild policy. Applies to every csproj before its own
    PropertyGroup is read; csprojs may still override any property locally,
    but should not.

    Strict-by-default: warnings are errors, NetAnalyzers run at "All",
    Meziantou.Analyzer is applied to every project, IDE0xxx style rules
    are enforced at build time, and CSharpier verifies formatting on
    every build via CSharpier.MsBuild.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- Analyzer policy -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <MeziantouAnalysisMode>All</MeziantouAnalysisMode>

    <!-- Documentation generation; XML doc warnings are surfaced. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      Warnings policy: warnings are errors. Unconditional - Debug, Release,
      IDE, and CI all see the same gate. The fix path for a warning is
      either to fix the code or to add a documented per-callsite
      [SuppressMessage] attribute. There is no broad suppression baseline.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      CS1591 (missing XML doc) is downgraded because GenerateDocumentationFile
      lights it up across every internal symbol. Public API docs are still
      enforced via SA-style review; the analyzer pack catches genuinely
      missing docs on public surfaces via different rules.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!--
      CSharpier.MsBuild runs `csharpier check` as a build target. Unformatted
      C# fails the build everywhere - IDE, CLI, CI - identically.
    -->
    <CSharpier_Check>true</CSharpier_Check>
  </PropertyGroup>

  <!--
    Analyzer + formatter packages applied to every project.
    PrivateAssets="all" keeps them out of consumers' transitive graph;
    analyzer-only assets are pulled in via IncludeAssets.
  -->
  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="CSharpier.MsBuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
