{
  "name": "hotrepl-workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["packages/*", "site"],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "test": "bun run build && bun test packages/*/test",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "schemas:export": "bun run --cwd packages/protocol schemas:export",
    "changeset": "changeset",
    "version": "changeset version && dprint fmt packages/*/CHANGELOG.md",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/bun": "latest",
    "tsup": "^8.5.1",
    "typescript": "^7.0.0"
  },
  "patchedDependencies": {
    "tsup@8.5.1": "patches/tsup@8.5.1.patch"
  }
}
