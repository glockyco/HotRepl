# Normalize line endings on checkin to LF; check out as-is on disk.
# This prevents CRLF churn between Unix/macOS contributors and Windows
# contributors (likely audience: Unity/BepInEx modders).
* text=auto eol=lf

# Explicit text files — belt-and-suspenders for the few extensions that
# `text=auto` heuristics occasionally misclassify.
*.cs       text eol=lf
*.csproj   text eol=lf
*.props    text eol=lf
*.targets  text eol=lf
*.slnx     text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.toml     text eol=lf
*.py       text eol=lf
*.sh       text eol=lf
*.editorconfig text eol=lf

# Binary assets — never line-ending normalize, never diff.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary

# Vendored DLLs are LFS-tracked. Preserves existing behavior.
*.dll filter=lfs diff=lfs merge=lfs -text
