{
  "type": "object",
  "required": [
    "name",
    "majorVersion",
    "kind",
    "mutatesState",
    "inputSchema",
    "outputSchema",
    "artifactsSchema"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "majorVersion": {
      "type": "number"
    },
    "kind": {
      "anyOf": [
        {
          "type": "string",
          "const": "sync"
        },
        {
          "type": "string",
          "const": "job"
        }
      ]
    },
    "mutatesState": {
      "type": "boolean"
    },
    "inputSchema": {
      "type": "object",
      "patternProperties": {
        "^.*$": {}
      }
    },
    "outputSchema": {
      "type": "object",
      "patternProperties": {
        "^.*$": {}
      }
    },
    "artifactsSchema": {
      "type": "object",
      "patternProperties": {
        "^.*$": {}
      }
    },
    "cancellation": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
