{
  "name": "@hotrepl/protocol",
  "version": "2.0.0",
  "description": "Canonical HotRepl v2 wire protocol types and JSON Schemas.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "schemas"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
