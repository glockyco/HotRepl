{
  "name": "@hotrepl/protocol",
  "version": "4.0.0",
  "description": "Canonical HotRepl v2 wire protocol types and JSON Schemas.",
  "keywords": [
    "hotrepl",
    "unity",
    "csharp",
    "websocket",
    "protocol",
    "typebox"
  ],
  "homepage": "https://hotrepl.glockyco.com",
  "bugs": "https://github.com/glockyco/HotRepl/issues",
  "license": "MIT",
  "author": "Johann Glock",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glockyco/HotRepl.git",
    "directory": "packages/protocol"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "dist",
    "schemas"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "schemas:export": "bun ./scripts/export-schemas.ts"
  },
  "dependencies": {
    "typebox": "^1.0.0"
  }
}
