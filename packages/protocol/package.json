{
  "name": "@hotrepl/protocol",
  "version": "2.0.0",
  "description": "Canonical HotRepl v2 wire protocol types and JSON Schemas.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "schemas:export": "bun ./scripts/export-schemas.ts"
  },
  "dependencies": {
    "typebox": "^1.0.0"
  }
}
