{
  "name": "@hotrepl/conformance",
  "version": "2.0.0-alpha.0",
  "description": "Reusable conformance checks for HotRepl v2 runtimes.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./fake-runtime-target": "./src/fake-runtime-target.ts",
    "./websocket-target": "./src/websocket-target.ts"
  },
  "scripts": {
    "build": "bun test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hotrepl/protocol": "2.0.0-alpha.0",
    "@hotrepl/sdk": "2.0.0-alpha.0",
    "@hotrepl/testing": "2.0.0-alpha.0"
  }
}
