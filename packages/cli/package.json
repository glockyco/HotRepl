{
  "name": "@hotrepl/cli",
  "version": "2.0.0",
  "description": "HotRepl v2 command-line client — inspect and automate a running Unity game's REPL from your shell.",
  "keywords": [
    "hotrepl",
    "unity",
    "csharp",
    "cli",
    "repl",
    "command-line"
  ],
  "homepage": "https://hotrepl.glockyco.com",
  "bugs": "https://github.com/glockyco/HotRepl/issues",
  "license": "MIT",
  "author": "Johann Glock",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glockyco/HotRepl.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "bin": {
    "hotrepl": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hotrepl/sdk": "2.0.0"
  },
  "devDependencies": {
    "@hotrepl/testing": "2.0.0"
  }
}
