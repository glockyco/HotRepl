{
  "name": "@hotrepl/mcp",
  "version": "2.0.0",
  "description": "HotRepl v2 MCP stdio server — expose a running Unity game's REPL and typed commands to MCP-enabled agents.",
  "keywords": [
    "hotrepl",
    "unity",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "stdio"
  ],
  "homepage": "https://hotrepl.glockyco.com",
  "bugs": "https://github.com/glockyco/HotRepl/issues",
  "license": "MIT",
  "author": "Johann Glock",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glockyco/HotRepl.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "bin": {
    "hotrepl-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hotrepl/sdk": "2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@hotrepl/testing": "2.0.0"
  }
}
