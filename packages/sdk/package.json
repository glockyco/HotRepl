{
  "name": "@hotrepl/sdk",
  "version": "3.0.0",
  "description": "Canonical TypeScript SDK for HotRepl v2 runtimes.",
  "keywords": [
    "hotrepl",
    "unity",
    "csharp",
    "repl",
    "websocket",
    "sdk",
    "client"
  ],
  "homepage": "https://hotrepl.glockyco.com",
  "bugs": "https://github.com/glockyco/HotRepl/issues",
  "license": "MIT",
  "author": "Johann Glock",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glockyco/HotRepl.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hotrepl/protocol": "3.0.0"
  },
  "devDependencies": {
    "@hotrepl/testing": "2.0.0"
  }
}
