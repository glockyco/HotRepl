<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>HotRepl.Protocol</RootNamespace>
    <AssemblyName>HotRepl.Protocol</AssemblyName>
    <PackageId>HotRepl.Protocol</PackageId>
    <Version>2.0.0-alpha.0</Version>
    <Authors>Johann Glock</Authors>
    <Description>Canonical HotRepl v2 wire protocol DTOs for .NET hosts and consumers.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
</Project>
