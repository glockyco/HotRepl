<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AnalysisMode>Recommended</AnalysisMode>
    <RootNamespace>HotRepl</RootNamespace>
    <AssemblyName>HotRepl.Core</AssemblyName>
    <PackageId>HotRepl.Core</PackageId>
    <Version>3.0.0</Version>
    <Authors>Johann Glock</Authors>
    <Description>Unity-safe HotRepl v3 runtime core with typed command authoring.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebSocket server -->
    <PackageReference Include="Fleck" />

    <!-- JSON serialization -->
    <PackageReference Include="Newtonsoft.Json" />

    <!-- JSON schema generation (ILRepack-internalized) -->
    <PackageReference Include="NJsonSchema" PrivateAssets="all" />
    <PackageReference Include="Namotion.Reflection" />

    <!-- ILRepack for internalizing NJsonSchema; Namotion.Reflection stays side-by-side -->
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../HotRepl.Protocol/HotRepl.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>HotRepl.BepInEx</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>HotRepl.Host.MelonLoader</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>HotRepl.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
