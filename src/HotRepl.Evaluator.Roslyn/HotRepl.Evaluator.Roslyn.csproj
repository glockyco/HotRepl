<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net6.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AnalysisMode>Recommended</AnalysisMode>
    <RootNamespace>HotRepl.Evaluator.Roslyn</RootNamespace>
    <AssemblyName>HotRepl.Evaluator.Roslyn</AssemblyName>
    <!-- MelonLoader 0.7 runs on .NET 6; Roslyn 4.4 depends on the shared-framework System.Collections.Immutable 6.x instead of forcing side-by-side BCL assemblies through MelonLoader's resolver. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HotRepl.Core/HotRepl.Core.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.4.0" />
  </ItemGroup>
</Project>
