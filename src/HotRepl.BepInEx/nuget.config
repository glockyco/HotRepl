<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Per-project NuGet sources for the BepInEx host plugin.
    Central Package Management (Directory.Packages.props) requires explicit
    source mapping when more than one source is in scope so package origin
    is unambiguous.
  -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="bepinex" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="bepinex">
      <package pattern="BepInEx.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
